<style>
    :root {
        --color-primary: #0f172a;
        --color-accent: #c6a667;
        --color-bg: #fdfcf9;
    }
    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--color-bg);
        color: var(--color-primary);
        -webkit-font-smoothing: antialiased;
    }

    .text-slate-600 {
        color: dimgray !important; /* Questo sovrascrive il default di Tailwind */
    }
    .serif { font-family: 'Playfair Display', serif; }
    .swiper-pagination-bullet-active { background: var(--color-accent) !important; }

    /* Utility per immagini verticali 3:4 */
    .portrait-img {
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        border-radius: 2px;
    }

    /* Animazione hover */
    .zoom-effect {
        transition: transform 0.6s ease-out;
    }
    .group:hover .zoom-effect {
        transform: scale(1.03);
        will-change: transform;
    }

    iframe[title="Mappa La Volta di Chiara"] {
        filter: grayscale(0.2) contrast(1.1);
    }

    /* --- Pulsanti Contatto (Chiama / WhatsApp) --- */
    .contact-btn {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1.25rem;
        border-radius: 9999px;
        font-family: 'Montserrat', sans-serif;
        transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
    }
    .contact-btn:active {
        transform: scale(0.97);
    }
    .contact-btn__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .contact-btn__text {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
        text-align: left;
    }
    .contact-btn__label {
        font-size: 8px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        opacity: 0.65;
        font-weight: 600;
    }
    .contact-btn__number {
        font-size: 13px;
        letter-spacing: 0.03em;
        font-weight: 700;
    }

    /* Variante primaria (oro) */
    .contact-btn--primary {
        background: #c5a368;
        color: #ffffff;
        box-shadow: 0 8px 20px rgba(197, 163, 104, 0.35);
    }
    .contact-btn--primary .contact-btn__icon {
        background: rgba(255, 255, 255, 0.22);
        color: #ffffff;
    }
    .contact-btn--primary:hover {
        background: #b3915b;
    }

    /* Variante secondaria (vetro scuro) */
    .contact-btn--secondary {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #ffffff;
    }
    .contact-btn--secondary .contact-btn__icon {
        background: rgba(255, 255, 255, 0.14);
        color: #c5a368;
    }
    .contact-btn--secondary:hover {
        background: rgba(255, 255, 255, 0.16);
    }

    /* Variante WhatsApp piena */
    .contact-btn--whatsapp {
        background: #25D366;
        color: #ffffff;
        box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
    }
    .contact-btn--whatsapp .contact-btn__icon {
        background: rgba(255, 255, 255, 0.22);
        color: #ffffff;
    }
    .contact-btn--whatsapp:hover {
        background: #1ebe5a;
    }

    /* Variante WhatsApp outline (per contesti scuri, secondo numero) */
    .contact-btn--whatsapp-outline {
        background: transparent;
        border: 1.5px solid #25D366;
        color: #25D366;
    }
    .contact-btn--whatsapp-outline .contact-btn__icon {
        background: rgba(37, 211, 102, 0.12);
        color: #25D366;
    }
    .contact-btn--whatsapp-outline:hover {
        background: rgba(37, 211, 102, 0.1);
    }

    /* Variante scura (per sfondi chiari, es. dropdown header desktop) */
    .contact-btn--dark-outline {
        background: transparent;
        border: 1.5px solid rgba(15, 23, 42, 0.15);
        color: #0f172a;
    }
    .contact-btn--dark-outline .contact-btn__icon {
        background: rgba(197, 163, 104, 0.12);
        color: #c5a368;
    }
    .contact-btn--dark-outline:hover {
        background: rgba(15, 23, 42, 0.04);
    }

    /* Pulsanti compatti per la barra sticky mobile */
    .contact-btn--compact {
        padding: 0.65rem 0.5rem;
        border-radius: 0.5rem;
        justify-content: center;
        gap: 0.5rem;
    }
    .contact-btn--compact .contact-btn__icon {
        width: 1.6rem;
        height: 1.6rem;
    }
    .contact-btn--compact .contact-btn__number {
        font-size: 12px;
    }
</style>


